# hoster.kz (Apache / LiteSpeed): the static site from playground/dist.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<Files ".htaccess">
  Require all denied
</Files>

AddDefaultCharset utf-8
AddCharset utf-8 .js .css .xml .txt .webmanifest .svg
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On
  # .well-known stays on http so the SSL certificate can be issued and renewed
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # inputs live in ?q= (IIN, IBAN, sums): other sites get only the origin
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # pages and the service worker must update at once
  <FilesMatch "\.(html|webmanifest|xml|txt)$|^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Vite file names carry a content hash
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
