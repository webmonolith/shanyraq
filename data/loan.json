  "gesv": {
    "formula": "gesvRules, п. 11: D − k + Σ Sj / (1 + APR)^(tj/365) = Σ Pi / (1 + APR)^(ti/365); D — сумма первого займа, k — платежи клиента банку при получении займа на дату получения, Sj — последующие выплаты клиенту, Pi — платежи клиента, tj и ti — дни со дня предоставления первого займа",
    "included": "gesvRules, п. 12, 14: платежи по основному долгу и вознаграждению, комиссии и иные платежи, связанные с выдачей и обслуживанием займа, известные на дату договора",
    "excluded": "gesvRules, п. 15: платежи третьим лицам (кроме перечисленных), неустойка и иные штрафные санкции",
    "method": "gesvRules, п. 22: алгебраическим методом последовательными приближениями; произведённые выплаты — на даты фактических выплат, будущие — по графику",
    "decimals": 2,
    "rounding": "gesvRules, п. 23: до сотых; тысячная доля ≥ 5 — сотая увеличивается на 1",
    "decimalsNonBank": 1,
    "roundingNonBank": "gesvRulesNonBank, п. 9: до десятых; сотая доля ≥ 5 — десятая увеличивается на 1"
  },
